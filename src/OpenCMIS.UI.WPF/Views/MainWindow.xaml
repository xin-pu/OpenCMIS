<Window x:Class="OpenCMIS.UI.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenCMIS.UI.WPF.ViewModels"
        xmlns:views="clr-namespace:OpenCMIS.UI.WPF.Views"
        xmlns:converters="clr-namespace:OpenCMIS.UI.WPF.Converters"
        xmlns:dxa="http://schemas.devexpress.com/winfx/2008/xaml/accordion"
        Title="OpenCMIS Manager"
        Icon="/Resources/mote-green.ico"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OpenCmisWindowBackgroundBrush}">

    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:DeviceConnectionViewModel}">
            <views:DeviceConnectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ControlPanelViewModel}">
            <views:ControlPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CdbEditorViewModel}">
            <views:CdbEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplicationSwitchViewModel}">
            <views:ApplicationSwitchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PageEditorViewModel}">
            <views:PageEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModuleHomeViewModel}">
            <views:ModuleHomeView />
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource OpenCmisSidebarBrush}"
                BorderBrush="{StaticResource OpenCmisBorderBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="OpenCMIS"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource OpenCmisAccentBrush}"
                           Margin="16,16,16,8" />

                <dxa:AccordionControl x:Name="NavAccordion"
                                      SelectionMode="Single"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      Margin="4,4,4,0">
                    <dxa:AccordionControl.Resources>
                        <Style TargetType="dxa:AccordionItem">
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Padding" Value="12,0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource OpenCmisMutedTextBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="NavAccordionItem_Click" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource OpenCmisSelectedBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource OpenCmisAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource OpenCmisHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource OpenCmisTextBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </dxa:AccordionControl.Resources>

                    <dxa:AccordionItem Tag="DeviceConnection" IsSelected="True">
                        <dxa:AccordionItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Text="&#xE80F;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Device Connection" VerticalAlignment="Center" />
                            </StackPanel>
                        </dxa:AccordionItem.Header>
                    </dxa:AccordionItem>

                    <dxa:AccordionItem Tag="ModuleHome">
                        <dxa:AccordionItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Text="&#xE9D2;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Module Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </dxa:AccordionItem.Header>
                    </dxa:AccordionItem>

                    <dxa:AccordionItem Tag="PageEditor">
                        <dxa:AccordionItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Text="&#xE70F;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Page Editor" VerticalAlignment="Center" />
                            </StackPanel>
                        </dxa:AccordionItem.Header>
                    </dxa:AccordionItem>

                    <dxa:AccordionItem Tag="ControlPanel">
                        <dxa:AccordionItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Text="&#xE713;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Control Panel" VerticalAlignment="Center" />
                            </StackPanel>
                        </dxa:AccordionItem.Header>
                    </dxa:AccordionItem>

                    <dxa:AccordionItem Tag="CdbEditor">
                        <dxa:AccordionItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Text="&#xEADE;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="CDB Editor" VerticalAlignment="Center" />
                            </StackPanel>
                        </dxa:AccordionItem.Header>
                    </dxa:AccordionItem>

                    <dxa:AccordionItem Tag="ApplicationSwitch">
                        <dxa:AccordionItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Text="&#xE8AB;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Application Switch" VerticalAlignment="Center" />
                            </StackPanel>
                        </dxa:AccordionItem.Header>
                    </dxa:AccordionItem>
                </dxa:AccordionControl>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <ContentControl Content="{Binding ActiveView}"
                            Margin="12"
                            Foreground="{StaticResource OpenCmisTextBrush}" />

            <StatusBar Grid.Row="1"
                       Background="{StaticResource OpenCmisSidebarBrush}"
                       Foreground="{StaticResource OpenCmisTextBrush}">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem Grid.Column="0">
                    <TextBlock>
                        <Run Text="Status: " />
                        <Run Text="{Binding ConnectionStatus}" />
                    </TextBlock>
                </StatusBarItem>
                <StatusBarItem Grid.Column="2">
                    <TextBlock Text="{Binding DeviceName}" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>