<UserControl x:Class="OpenCMIS.UI.WPF.Views.CdbEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="CDB Editor" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Read CDB" Command="{Binding ReadCdbCommand}" Margin="0,0,10,0" />
            <Button Content="Write CDB" Command="{Binding WriteCdbCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding CdbInfo}" FontWeight="Bold" Margin="0,0,0,10" />

        <DataGrid ItemsSource="{Binding Fields}" AutoGenerateColumns="False"
                  CanUserAddRows="False" MaxHeight="400">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="150" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
