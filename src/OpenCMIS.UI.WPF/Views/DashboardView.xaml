<UserControl x:Class="OpenCMIS.UI.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OpenCMIS.UI.WPF.Converters">
    <UserControl.Resources>
        <converters:ModuleStateToColorConverter x:Key="ModuleStateToColorConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />

        <GroupBox Header="Module Status" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="State: " FontWeight="Bold" VerticalAlignment="Center" />
                    <Ellipse Width="16" Height="16" Margin="10,0,5,0"
                             Fill="{Binding CurrentState, Converter={StaticResource ModuleStateToColorConverter}}" />
                    <TextBlock Text="{Binding CurrentState}" FontSize="16" FontWeight="Bold" />
                </StackPanel>

                <TextBlock Margin="0,5,0,0">
                    <Run Text="Module Ready: " FontWeight="Bold" />
                    <Run Text="{Binding IsReady}" />
                </TextBlock>
                <TextBlock Margin="0,5,0,0">
                    <Run Text="Has Alerts: " FontWeight="Bold" />
                    <Run Text="{Binding HasAlerts}" Foreground="{Binding HasAlerts, Converter={StaticResource ModuleStateToColorConverter}}" />
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Active Alerts" Padding="10" Margin="0,0,0,15"
                  Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListBox ItemsSource="{Binding ActiveAlerts}" MaxHeight="150" />
        </GroupBox>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Refresh Status"
                    Command="{Binding RefreshStatusCommand}"
                    IsEnabled="{Binding IsMonitoring, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                    Margin="0,0,10,0" />
            <Button Content="Start Monitor"
                    Command="{Binding StartMonitoringCommand}"
                    IsEnabled="{Binding IsMonitoring, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                    Margin="0,0,10,0" />
            <Button Content="Stop Monitor"
                    Command="{Binding StopMonitoringCommand}"
                    Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource OpenCmisMutedTextBrush}" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
