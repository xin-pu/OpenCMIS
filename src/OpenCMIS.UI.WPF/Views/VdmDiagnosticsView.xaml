<UserControl x:Class="OpenCMIS.UI.WPF.Views.VdmDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="VDM Diagnostics" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Descriptor-driven observables · raw samples · read-only"
                       Foreground="{StaticResource OpenCmisMutedTextBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <dx:SimpleButton Content="Refresh" Command="{Binding RefreshAllCommand}" Margin="0,0,12,0" />
            <TextBlock Text="Interval (s):" VerticalAlignment="Center" Margin="0,0,8,0" />
            <dxe:ComboBoxEdit ItemsSource="{Binding RefreshIntervalOptions}"
                              EditValue="{Binding RefreshInterval, Mode=TwoWay}" Width="60" Margin="0,0,12,0" />
            <dx:SimpleButton Content="Start Monitor" Command="{Binding StartMonitoringCommand}" Margin="0,0,8,0" />
            <dx:SimpleButton Content="Stop Monitor" Command="{Binding StopMonitoringCommand}" Margin="0,0,16,0" />
            <TextBlock Text="{Binding ActiveFlagCount, StringFormat='Active flags: {0}'}" VerticalAlignment="Center" />
        </StackPanel>
        <dxg:GridControl Grid.Row="2" ItemsSource="{Binding ObservableRows}" AutoGenerateColumns="None">
            <dxg:GridControl.View>
                <dxg:TableView AllowEditing="False" ShowGroupPanel="False" AutoWidth="True" />
            </dxg:GridControl.View>
            <dxg:GridControl.Columns>
                <dxg:GridColumn Header="Instance" FieldName="Instance" Width="75" />
                <dxg:GridColumn Header="Descriptor (hex bytes)" FieldName="DescriptorHex" Width="170" />
                <dxg:GridColumn Header="Raw sample (hex)" FieldName="SampleHex" Width="140" />
                <dxg:GridColumn Header="High alarm" FieldName="Flags.HighAlarm" Width="100" />
                <dxg:GridColumn Header="High warning" FieldName="Flags.HighWarning" Width="110" />
                <dxg:GridColumn Header="Low warning" FieldName="Flags.LowWarning" Width="110" />
                <dxg:GridColumn Header="Low alarm" FieldName="Flags.LowAlarm" Width="100" />
            </dxg:GridControl.Columns>
        </dxg:GridControl>
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="0,12,0,0"
                   Foreground="{StaticResource OpenCmisMutedTextBrush}" />
    </Grid>
</UserControl>
