<UserControl x:Class="OpenCMIS.UI.WPF.Views.DeviceConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">

    <StackPanel MaxWidth="500"
                Background="Transparent">
        <TextBlock Text="Device Connection" Style="{StaticResource PageTitleStyle}" />

        <GroupBox Header="Scan &amp; Connect" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Adapter:" Style="{StaticResource SectionLabelStyle}"
                           Margin="0,0,0,4" />
                <dxe:ComboBoxEdit ItemsSource="{Binding AvailableAdapters}"
                                   EditValue="{Binding SelectedAdapter}"
                                   IsEnabled="{Binding IsConnected, Converter={StaticResource BoolInvertConverter}}"
                                   Margin="0,0,0,10" />

                <TextBlock Text="Port:" Style="{StaticResource SectionLabelStyle}"
                           Margin="0,0,0,4" />
                <dxe:ComboBoxEdit ItemsSource="{Binding AvailablePorts}"
                                   EditValue="{Binding SelectedPort}"
                                   IsEnabled="{Binding IsConnected, Converter={StaticResource BoolInvertConverter}}"
                                   Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <dx:SimpleButton Content="Scan"
                                     Command="{Binding ScanPortsCommand}"
                                     IsEnabled="{Binding IsScanning, Converter={StaticResource BoolInvertConverter}}"
                                     Margin="0,0,5,0" />

                    <dx:SimpleButton Grid.Column="1"
                                     Content="Connect"
                                     Command="{Binding ConnectCommand}"
                                     Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                     Margin="5,0,0,0" />
                </Grid>

                <dx:SimpleButton Content="Disconnect"
                                 Command="{Binding DisconnectCommand}"
                                 Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,10,0,0" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Device Info" Padding="10"
                  Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock>
                    <Run Text="Vendor: " FontWeight="Bold" />
                    <Run Text="{Binding VendorName}" />
                </TextBlock>
                <TextBlock Margin="0,5,0,0">
                    <Run Text="Part Number: " FontWeight="Bold" />
                    <Run Text="{Binding PartNumber}" />
                </TextBlock>
                <TextBlock Margin="0,5,0,0">
                    <Run Text="Serial Number: " FontWeight="Bold" />
                    <Run Text="{Binding SerialNumber}" />
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusTextStyle}" />
    </StackPanel>
</UserControl>
