<UserControl x:Class="OpenCMIS.UI.WPF.Views.ModuleHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OpenCMIS.UI.WPF.Converters"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
    <UserControl.Resources>
        <converters:ModuleStateToColorConverter x:Key="ModuleStateToColorConverter" />
        <converters:MonitorValueToColorConverter x:Key="MonitorValueToColorConverter" />
        <converters:ThresholdWidthConverter x:Key="ThresholdWidthConverter" />

        <Style x:Key="GaugeCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource OpenCmisSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="180" />
        </Style>

        <Style x:Key="IdentityLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource OpenCmisMutedTextBrush}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style x:Key="IdentityValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                             Fill="{Binding CurrentStateText, Converter={StaticResource ModuleStateToColorConverter}}" />
                    <TextBlock Text="Module Home" Style="{StaticResource PageTitleStyle}"
                               Margin="0,0,0,0" />
                </StackPanel>
                <TextBlock Margin="28,2,0,0" FontSize="13">
                    <Run Text="State: " Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                    <Run Text="{Binding CurrentStateText}" FontWeight="Bold" />
                    <Run Text=" | " Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                    <Run Text="Ready: " Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                    <Run Text="{Binding DashData.IsReady}" FontWeight="Bold" />
                </TextBlock>
            </StackPanel>

            <!-- Module Identity Card -->
            <GroupBox Header="Module Identity" Padding="10" Margin="0,0,0,15">
                <UniformGrid Columns="2" Rows="6">
                    <!-- Row 1 -->
                    <StackPanel>
                        <TextBlock Text="Vendor Name" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.VendorName}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Vendor OUI" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.VendorOUI}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <!-- Row 2 -->
                    <StackPanel>
                        <TextBlock Text="Part Number" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.PartNumber}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Serial Number" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.SerialNumber}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <!-- Row 3 -->
                    <StackPanel>
                        <TextBlock Text="Hardware Revision" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.HardwareRevision}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Firmware Revision" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.FirmwareRevision}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <!-- Row 4 -->
                    <StackPanel>
                        <TextBlock Text="Date Code" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.DateCode}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Module Type" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.ModuleType}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <!-- Row 5 -->
                    <StackPanel>
                        <TextBlock Text="Connector Type" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.ConnectorType}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CMIS Version" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.CmisVersion}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <!-- Row 6 -->
                    <StackPanel>
                        <TextBlock Text="CLEI Code" Style="{StaticResource IdentityLabelStyle}" />
                        <TextBlock Text="{Binding DashData.Identity.CLEICode}"
                                   Style="{StaticResource IdentityValueStyle}" />
                    </StackPanel>
                    <StackPanel />
                </UniformGrid>
            </GroupBox>

            <!-- Real-Time Monitor Gauges -->
            <GroupBox Header="Real-Time Monitors" Padding="10" Margin="0,0,0,15">
                <WrapPanel>
                    <!-- Temperature -->
                    <Border Style="{StaticResource GaugeCardBorderStyle}">
                        <Border.BorderBrush>
                            <Binding Path="DashData.Monitors.Temperature"
                                     Converter="{StaticResource MonitorValueToColorConverter}" />
                        </Border.BorderBrush>
                        <Border.BorderThickness>
                            <Binding Path="DashData.Monitors.Temperature.HasAlarm" FallbackValue="1">
                                <Binding.Converter>
                                    <converters:BoolToVisibilityConverter />
                                </Binding.Converter>
                            </Binding>
                        </Border.BorderThickness>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TEMPERATURE" FontSize="10"
                                       Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            <TextBlock FontSize="24" FontWeight="Bold" Margin="0,4,0,0">
                                <Run Text="{Binding DashData.Monitors.Temperature.Value, StringFormat=F2}" />
                                <Run Text=" " FontSize="14" />
                                <Run Text="{Binding DashData.Monitors.Temperature.Unit}" FontSize="14"
                                     Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="0,2,0,0"
                                       Foreground="{Binding DashData.Monitors.Temperature, Converter={StaticResource MonitorValueToColorConverter}}">
                                <Run Text="{Binding DashData.Monitors.Temperature.StatusText, Mode=OneWay}" />
                            </TextBlock>
                            <!-- Threshold Range Bar -->
                            <Grid Height="8" Margin="0,4,0,0">
                                <Rectangle Fill="{StaticResource OpenCmisInputBackgroundBrush}" RadiusX="4" RadiusY="4" />
                                <Rectangle HorizontalAlignment="Left" RadiusX="4" RadiusY="4"
                                           Fill="{Binding DashData.Monitors.Temperature, Converter={StaticResource MonitorValueToColorConverter}}">
                                    <Rectangle.Width>
                                        <Binding Path="DashData.Monitors.Temperature"
                                                 Converter="{StaticResource ThresholdWidthConverter}"
                                                 ConverterParameter="176" />
                                    </Rectangle.Width>
                                </Rectangle>
                            </Grid>
                            <!-- Threshold Values -->
                            <Grid Margin="0,3,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="9" Foreground="{StaticResource OpenCmisMutedTextBrush}">
                                    <Run Text="ALM H:" />
                                    <Run Text="{Binding DashData.Monitors.Temperature.AlarmHigh, StringFormat=F1}"
                                         Foreground="{StaticResource OpenCmisDangerBrush}" />
                                    <Run Text="  WRN H:" />
                                    <Run Text="{Binding DashData.Monitors.Temperature.WarnHigh, StringFormat=F1}"
                                         Foreground="{StaticResource OpenCmisWarningBrush}" />
                                </TextBlock>
                                <TextBlock Grid.Row="1" FontSize="9"
                                           Foreground="{StaticResource OpenCmisMutedTextBrush}">
                                    <Run Text="WRN L:" />
                                    <Run Text="{Binding DashData.Monitors.Temperature.WarnLow, StringFormat=F1}"
                                         Foreground="{StaticResource OpenCmisWarningBrush}" />
                                    <Run Text="  ALM L:" />
                                    <Run Text="{Binding DashData.Monitors.Temperature.AlarmLow, StringFormat=F1}"
                                         Foreground="{StaticResource OpenCmisDangerBrush}" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- VCC -->
                    <Border Style="{StaticResource GaugeCardBorderStyle}"
                            BorderBrush="{Binding DashData.Monitors.VCC, Converter={StaticResource MonitorValueToColorConverter}}"
                            BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SUPPLY VOLTAGE" FontSize="10"
                                       Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            <TextBlock FontSize="24" FontWeight="Bold" Margin="0,4,0,0">
                                <Run Text="{Binding DashData.Monitors.VCC.Value, StringFormat=F3}" />
                                <Run Text=" " FontSize="14" />
                                <Run Text="{Binding DashData.Monitors.VCC.Unit}" FontSize="14"
                                     Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="0,2,0,0"
                                       Foreground="{Binding DashData.Monitors.VCC, Converter={StaticResource MonitorValueToColorConverter}}">
                                <Run Text="{Binding DashData.Monitors.VCC.StatusText, Mode=OneWay}" />
                            </TextBlock>
                            <!-- Threshold Range Bar -->
                            <Grid Height="8" Margin="0,4,0,0">
                                <Rectangle Fill="{StaticResource OpenCmisInputBackgroundBrush}" RadiusX="4" RadiusY="4" />
                                <Rectangle HorizontalAlignment="Left" RadiusX="4" RadiusY="4"
                                           Fill="{Binding DashData.Monitors.VCC, Converter={StaticResource MonitorValueToColorConverter}}">
                                    <Rectangle.Width>
                                        <Binding Path="DashData.Monitors.VCC"
                                                 Converter="{StaticResource ThresholdWidthConverter}"
                                                 ConverterParameter="176" />
                                    </Rectangle.Width>
                                </Rectangle>
                            </Grid>
                            <!-- Threshold Values (no low warning per CMIS 5.2) -->
                            <Grid Margin="0,3,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="9" Foreground="{StaticResource OpenCmisMutedTextBrush}">
                                    <Run Text="ALM H:" />
                                    <Run Text="{Binding DashData.Monitors.VCC.AlarmHigh, StringFormat=F3}"
                                         Foreground="{StaticResource OpenCmisDangerBrush}" />
                                    <Run Text="  WRN H:" />
                                    <Run Text="{Binding DashData.Monitors.VCC.WarnHigh, StringFormat=F3}"
                                         Foreground="{StaticResource OpenCmisWarningBrush}" />
                                </TextBlock>
                                <TextBlock Grid.Row="1" FontSize="9"
                                           Foreground="{StaticResource OpenCmisMutedTextBrush}">
                                    <Run Text="ALM L:" />
                                    <Run Text="{Binding DashData.Monitors.VCC.AlarmLow, StringFormat=F3}"
                                         Foreground="{StaticResource OpenCmisDangerBrush}" />
                                    <Run Text="  (no low warn)" FontStyle="Italic" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TX Power Total -->
                    <Border Style="{StaticResource GaugeCardBorderStyle}" BorderThickness="1"
                            BorderBrush="{StaticResource OpenCmisBorderBrush}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TX POWER TOTAL" FontSize="10"
                                       Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            <TextBlock FontSize="24" FontWeight="Bold" Margin="0,4,0,0">
                                <Run Text="{Binding DashData.Monitors.TotalTxPower, StringFormat=F3}" />
                                <Run Text=" mW" FontSize="14" Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            </TextBlock>
                            <TextBlock Text="AGGREGATE" FontSize="11"
                                       Foreground="{StaticResource OpenCmisMutedTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- RX Power Total -->
                    <Border Style="{StaticResource GaugeCardBorderStyle}" BorderThickness="1"
                            BorderBrush="{StaticResource OpenCmisBorderBrush}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RX POWER TOTAL" FontSize="10"
                                       Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            <TextBlock FontSize="24" FontWeight="Bold" Margin="0,4,0,0">
                                <Run Text="{Binding DashData.Monitors.TotalRxPower, StringFormat=F3}" />
                                <Run Text=" mW" FontSize="14" Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            </TextBlock>
                            <TextBlock Text="AGGREGATE" FontSize="11"
                                       Foreground="{StaticResource OpenCmisMutedTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- TX Bias Max -->
                    <Border Style="{StaticResource GaugeCardBorderStyle}" BorderThickness="1"
                            BorderBrush="{StaticResource OpenCmisBorderBrush}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TX BIAS MAX" FontSize="10"
                                       Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            <TextBlock FontSize="24" FontWeight="Bold" Margin="0,4,0,0">
                                <Run Text="{Binding DashData.Monitors.MaxTxBias, StringFormat=F2}" />
                                <Run Text=" mA" FontSize="14" Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            </TextBlock>
                            <TextBlock Text="MAX ACROSS LANES" FontSize="11"
                                       Foreground="{StaticResource OpenCmisMutedTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Summary -->
                    <Border Style="{StaticResource GaugeCardBorderStyle}" BorderThickness="1"
                            BorderBrush="{StaticResource OpenCmisBorderBrush}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="STATUS" FontSize="10" Foreground="{StaticResource OpenCmisMutedTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="14" Height="14"
                                         Fill="{Binding DashData.CurrentState, Converter={StaticResource ModuleStateToColorConverter}}" />
                                <TextBlock Text="{Binding DashData.CurrentState}" FontSize="16" FontWeight="Bold"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock FontSize="11" Margin="0,4,0,0"
                                       Foreground="{StaticResource OpenCmisMutedTextBrush}">
                                <Run Text="{Binding DashData.Lanes.Count, Mode=OneWay, StringFormat={}{0} lanes}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </GroupBox>

            <!-- Lane Details Table -->
            <GroupBox Header="Lane Details" Padding="10" Margin="0,0,0,15">
                <dxg:GridControl ItemsSource="{Binding DashData.Lanes}"
                                 AutoGenerateColumns="None"
                                 MaxHeight="250">
                    <dxg:GridControl.View>
                        <dxg:TableView ShowGroupPanel="False"
                                       ShowSearchPanelMode="Never"
                                       AllowEditing="False"
                                       AutoWidth="False" />
                    </dxg:GridControl.View>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn Header="Lane" FieldName="LaneNumber" Width="50" />
                        <dxg:GridColumn Header="TX Power (mW)" Width="120">
                            <dxg:GridColumn.Binding>
                                <Binding Path="TxPower" StringFormat="F4" />
                            </dxg:GridColumn.Binding>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="RX Power (mW)" Width="120">
                            <dxg:GridColumn.Binding>
                                <Binding Path="RxPower" StringFormat="F4" />
                            </dxg:GridColumn.Binding>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="TX Bias (mA)" Width="120">
                            <dxg:GridColumn.Binding>
                                <Binding Path="TxBias" StringFormat="F3" />
                            </dxg:GridColumn.Binding>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Enabled" FieldName="IsEnabled" Width="70" />
                        <dxg:GridColumn Header="Status" FieldName="StatusText" Width="*"
                                        MaxWidth="80">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource OpenCmisSuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Row.HasFault}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource OpenCmisDangerBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Row.IsEnabled}" Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource OpenCmisMutedTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="TX LOS" FieldName="TxLos" Width="55">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource OpenCmisMutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Value}" Value="True">
                                                        <Setter Property="Text" Value="LOS" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource OpenCmisDangerBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="RX LOS" FieldName="RxLos" Width="55">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource OpenCmisMutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Value}" Value="True">
                                                        <Setter Property="Text" Value="LOS" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource OpenCmisDangerBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="TX LOL" FieldName="TxLol" Width="55">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource OpenCmisMutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Value}" Value="True">
                                                        <Setter Property="Text" Value="LOL" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource OpenCmisDangerBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="RX LOL" FieldName="RxLol" Width="55">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource OpenCmisMutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Value}" Value="True">
                                                        <Setter Property="Text" Value="LOL" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource OpenCmisDangerBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn Header="Fault" FieldName="HasFault" Width="55">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource OpenCmisMutedTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Value}" Value="True">
                                                        <Setter Property="Text" Value="FAULT" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource OpenCmisDangerBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                </dxg:GridControl>
            </GroupBox>

            <!-- Controls -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Refresh:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Style="{StaticResource SectionLabelStyle}" />
                <dxe:ComboBoxEdit ItemsSource="{Binding RefreshIntervalOptions}"
                                  EditValue="{Binding RefreshInterval}"
                                  Width="60"
                                  IsEnabled="{Binding IsMonitoring, Converter={StaticResource BoolInvertConverter}}" />
                <TextBlock Text="s" VerticalAlignment="Center" Margin="2,0,12,0"
                           Foreground="{StaticResource OpenCmisMutedTextBrush}" />

                <dx:SimpleButton Content="Start Monitor"
                                 Command="{Binding StartMonitoringCommand}"
                                 Margin="0,0,8,0"
                                 Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                <dx:SimpleButton Content="Stop Monitor"
                                 Command="{Binding StopMonitoringCommand}"
                                 Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVisibilityConverter}}" />
                <dx:SimpleButton Content="Refresh Identity"
                                 Command="{Binding RefreshIdentityCommand}"
                                 Margin="16,0,0,0"
                                 Style="{StaticResource OpenCmisFlatButtonStyle}" />
            </StackPanel>

            <!-- Status -->
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>