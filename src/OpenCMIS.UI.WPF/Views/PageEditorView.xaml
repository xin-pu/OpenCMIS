<UserControl x:Class="OpenCMIS.UI.WPF.Views.PageEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:vm="clr-namespace:OpenCMIS.UI.WPF.ViewModels">
    <UserControl.Resources>
        <Style x:Key="HexTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxLength" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="OffsetTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource OpenCmisMutedTextBrush}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AsciiTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource OpenCmisMutedTextBrush}" />
            <Setter Property="Width" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ColumnLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource OpenCmisMutedTextBrush}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Page Editor" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,15" />

            <!-- Page Selection -->
            <Grid Margin="0,0,0,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Bank:" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontWeight="Bold" />
                <TextBox Grid.Column="1" Text="{Binding BankNumber, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="13" TextAlignment="Center"
                         MaxLength="2" />
                <TextBlock Grid.Column="2" Text="Page:" VerticalAlignment="Center" Margin="8,0,4,0"
                           FontWeight="Bold" />
                <TextBox Grid.Column="3" Text="{Binding PageNumber, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="13" TextAlignment="Center"
                         MaxLength="2" />
                <TextBlock Grid.Column="4" Text="Start:" VerticalAlignment="Center" Margin="8,0,4,0"
                           FontWeight="Bold" />
                <TextBox Grid.Column="5" Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="13" TextAlignment="Center"
                         MaxLength="2" />
                <TextBlock Grid.Column="6" Text="Len:" VerticalAlignment="Center" Margin="8,0,4,0"
                           FontWeight="Bold" />
                <TextBox Grid.Column="7" Text="{Binding ReadLength, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="13" TextAlignment="Center"
                         MaxLength="2" />
                <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="16,0,0,0">
                    <dx:SimpleButton Content="Read Page" Command="{Binding ReadPageCommand}" Margin="0,0,6,0" />
                    <dx:SimpleButton Content="Read Range" Command="{Binding ReadRangeCommand}" Margin="0,0,6,0" />
                    <dx:SimpleButton Content="Write + Verify" Command="{Binding WritePageCommand}" Margin="0,0,6,0" />
                    <dx:SimpleButton Content="Common" Command="{Binding ReadCommonPageCommand}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="8" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="16,4,0,0">
                    <dx:SimpleButton Content="Fill 00" Command="{Binding FillAllCommand}"
                                     Style="{StaticResource OpenCmisFlatButtonStyle}"
                                     FontSize="11" Padding="8,4" />
                    <dx:SimpleButton Content="Fill FF" Command="{Binding FillAllFFCommand}"
                                     Style="{StaticResource OpenCmisFlatButtonStyle}"
                                     FontSize="11" Padding="8,4" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding PageInfo}" FontWeight="Bold" Margin="0,0,0,8" />

            <!-- Column Headers -->
            <Border Padding="0,0,0,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Offset" Style="{StaticResource OffsetTextStyle}" Width="44" />
                    <!-- 00-0F headers -->
                    <TextBlock Text="00" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="01" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="02" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="03" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="04" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="05" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="06" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="07" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="08" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="09" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="0A" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="0B" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="0C" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="0D" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="0E" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text="0F" Style="{StaticResource ColumnLabelStyle}" />
                    <TextBlock Text=" ASCII" Style="{StaticResource AsciiTextStyle}" />
                </StackPanel>
            </Border>

            <Border BorderBrush="{StaticResource OpenCmisBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4" />

            <!-- Hex Rows -->
            <ItemsControl ItemsSource="{Binding HexRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HexRowViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Offset}" Style="{StaticResource OffsetTextStyle}" Width="44" />

                            <TextBox Text="{Binding Bytes[0].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[1].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[2].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[3].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[4].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[5].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[6].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[7].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[8].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[9].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[10].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[11].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[12].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[13].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[14].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />
                            <TextBox Text="{Binding Bytes[15].Hex, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource HexTextBoxStyle}"
                                     GotFocus="HexTextBox_GotFocus"
                                     TextChanged="HexTextBox_TextChanged" />

                            <TextBlock Text="{Binding Ascii}" Style="{StaticResource AsciiTextStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusTextStyle}" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>