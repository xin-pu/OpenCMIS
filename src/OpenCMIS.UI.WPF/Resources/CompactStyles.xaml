<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Shared page / section / status styles for the deep-green developer theme  -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource OpenCmisTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource OpenCmisMutedTextBrush}" />
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource OpenCmisMutedTextBrush}" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="OpenCmisFlatButtonStyle" TargetType="{x:Type dx:SimpleButton}">
        <Setter Property="Background" Value="{StaticResource OpenCmisSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OpenCmisBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OpenCmisTextBrush}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

</ResourceDictionary>