<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- OpenCMIS DevExpress Deep-Green Developer Theme -->
    <Color x:Key="OpenCmisWindowBackgroundColor">#071F18</Color>
    <Color x:Key="OpenCmisSidebarColor">#09281F</Color>
    <Color x:Key="OpenCmisSurfaceColor">#0E3328</Color>
    <Color x:Key="OpenCmisSurfaceAltColor">#123D31</Color>
    <Color x:Key="OpenCmisBorderColor">#23594A</Color>
    <Color x:Key="OpenCmisAccentColor">#2BD083</Color>
    <Color x:Key="OpenCmisAccentMutedColor">#1E7A58</Color>
    <Color x:Key="OpenCmisTextColor">#E5F4EE</Color>
    <Color x:Key="OpenCmisMutedTextColor">#93B8AA</Color>
    <Color x:Key="OpenCmisDangerColor">#E05D5D</Color>
    <Color x:Key="OpenCmisWarningColor">#D6B85A</Color>
    <Color x:Key="OpenCmisSuccessColor">#37C978</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="OpenCmisWindowBackgroundBrush" Color="#071F18" />
    <SolidColorBrush x:Key="OpenCmisSidebarBrush" Color="#09281F" />
    <SolidColorBrush x:Key="OpenCmisSurfaceBrush" Color="#0E3328" />
    <SolidColorBrush x:Key="OpenCmisSurfaceAltBrush" Color="#123D31" />
    <SolidColorBrush x:Key="OpenCmisBorderBrush" Color="#23594A" />
    <SolidColorBrush x:Key="OpenCmisAccentBrush" Color="#2BD083" />
    <SolidColorBrush x:Key="OpenCmisAccentMutedBrush" Color="#1E7A58" />
    <SolidColorBrush x:Key="OpenCmisTextBrush" Color="#E5F4EE" />
    <SolidColorBrush x:Key="OpenCmisMutedTextBrush" Color="#93B8AA" />
    <SolidColorBrush x:Key="OpenCmisDangerBrush" Color="#E05D5D" />
    <SolidColorBrush x:Key="OpenCmisWarningBrush" Color="#D6B85A" />
    <SolidColorBrush x:Key="OpenCmisSuccessBrush" Color="#37C978" />

    <!-- Selection / highlight -->
    <SolidColorBrush x:Key="OpenCmisSelectedBrush" Color="#1A2BD083" />
    <SolidColorBrush x:Key="OpenCmisHoverBrush" Color="#0D2BD083" />

    <!-- Input control backgrounds -->
    <SolidColorBrush x:Key="OpenCmisInputBackgroundBrush" Color="#0A281E" />
    <SolidColorBrush x:Key="OpenCmisInputBorderBrush" Color="#1C4A3C" />
    <SolidColorBrush x:Key="OpenCmisInputFocusBorderBrush" Color="#2BD083" />

</ResourceDictionary>